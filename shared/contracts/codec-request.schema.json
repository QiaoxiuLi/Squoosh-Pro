{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qiaoxiuli.github.io/squoosh-pro/contracts/codec-request.schema.json",
  "title": "Squoosh Pro Codec Request",
  "type": "object",
  "required": ["schemaVersion", "requestID", "operation", "codec", "width", "height", "pixelFormat", "options"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestID": { "type": "string", "format": "uuid" },
    "operation": { "enum": ["capabilities", "preview", "encode", "cancel", "shutdown"] },
    "codec": { "enum": ["mozjpeg", "oxipng", "webp", "avif"] },
    "width": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "height": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "pixelFormat": { "const": "rgba8" },
    "options": { "type": "object", "additionalProperties": { "type": ["number", "boolean", "string"] } }
  },
  "additionalProperties": true
}
